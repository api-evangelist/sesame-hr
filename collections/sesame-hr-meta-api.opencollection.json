{
  "opencollection": "1.0.0",
  "info": {
    "name": "Sesame HR Public Absences and Leave Meta API",
    "version": "3.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Meta",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Show token info",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api-eu1.sesametime.com/core/v3/info"
          },
          "docs": "Returns metadata about the authenticated API token and its company. Useful for verifying that a Bearer token is valid."
        }
      ]
    }
  ],
  "bundled": true
}